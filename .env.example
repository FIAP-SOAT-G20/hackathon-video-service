# Environment variables
# Copy this file to .env and update the values according to your setup

ENVIRONMENT=development

# Database Selection
# Set to "documentdb", "mongodb", or leave empty for PostgreSQL
DB_ENGINE=postgresql

# DocumentDB/MongoDB Configuration
DOCUMENTDB_URI=mongodb://username:password@cluster-endpoint:27017/database?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
DOCUMENTDB_NAME=video_service
DOCUMENTDB_TLS_ENABLED=true
DOCUMENTDB_TLS_CERT_PATH=/path/to/rds-combined-ca-bundle.pem
DOCUMENTDB_TLS_INSECURE=false

# PostgreSQL Configuration (fallback)
DB_DSN=host=localhost port=5432 user=postgres password=postgres dbname=video_service sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_GRACEFUL_SHUTDOWN_SEC_TIMEOUT=5s

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=24h

# AWS S3 Configuration
AWS_S3_BUCKET_NAME=fiapx-10soat-g21
AWS_S3_BUCKET_RAW_FOLDER=raw
AWS_S3_BUCKET_PROCESSED_FOLDER=processed
AWS_S3_PRESIGNED_URL_EXPIRATION=15m

# AWS SQS Configuration (if applicable)
AWS_SQS_VIDEO_UPDATED_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/your-queue-name
AWS_SQS_VIDEO_UPDATED_MAX_MESSAGES=10
AWS_SQS_VIDEO_UPDATED_WAIT_TIME_SECONDS=20

# AWS ElastiCache Configuration
CACHE_ENABLED=true
CACHE_ENDPOINT=your-elasticache-endpoint.cache.amazonaws.com
CACHE_PORT=6379
CACHE_DURATION=5m

METRICS_PORT=8081
